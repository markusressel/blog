{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "serve dist --listen 3000 --no-clipboard --no-port-switching",
    "postinstall": "nuxt prepare",
    "generate:serve": "yarn generate && yarn preview",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test 'yarn generate:serve' http://localhost:3000 'yarn cypress:open'",
    "test:e2e:ci": "start-server-and-test 'yarn generate:serve' http://localhost:3000 'yarn cypress:run'",
    "lint:js": "eslint .",
    "lint": "yarn lint:js",
    "snapshot": "node scripts/snapshot-site.mjs dist test/site-snapshot/current",
    "snapshot:baseline": "node scripts/snapshot-site.mjs dist test/site-snapshot/baseline",
    "snapshot:diff": "git diff --no-index test/site-snapshot/baseline test/site-snapshot/current"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "^2.2.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/sitemap": "^9.1.0",
    "minisearch": "^7.2.0",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-content-loader": "^2.0.1",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "node-html-parser": "^9.0.4",
    "nuxt-svgo": "^5.3.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "start-server-and-test": "^3.0.13",
    "typescript": "^6",
    "vue-tsc": "^3.3.13"
  },
  "resolutions": {
    "compression": "^1.8.2"
  }
}
